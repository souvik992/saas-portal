# PostgreSQL dedicated to Fine Dine SaaS. Never point this at an outlet SQLite database.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/finedine_saas
HOST=127.0.0.1
PORT=4100
NODE_ENV=development
# Public URL of the customer portal, used to build verification/reset links.
SAAS_WEB_URL=http://localhost:5173
# Comma-separated exact browser origins allowed to call the API.
SAAS_ALLOWED_ORIGINS=http://localhost:5173
# Required in production. Local development prints links to the API logger.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Fine Dine <no-reply@example.com>
SESSION_TTL_DAYS=14
# Licence keys (packages/licensing). The Ed25519 private key as a PEM file; leave empty to turn key issuing off.
# Keep it on this server only. Products trust its public half (GET /api/v1/licensing/public-keys) under the key id below.
LICENCE_SIGNING_KEY_FILE=
LICENCE_SIGNING_KEY_ID=cloud
LICENCE_MAX_DAYS=400
