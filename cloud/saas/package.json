{
  "name": "@finedine/saas-api",
  "version": "0.1.0",
  "private": true,
  "description": "Platform SaaS API: accounts, businesses, outlets, subscriptions and licence keys. SQLite (node:sqlite).",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "licensing": "npm install --prefix ../../packages/licensing --no-package-lock --no-audit --no-fund && npm run build --prefix ../../packages/licensing",
    "predev": "npm run licensing",
    "dev": "tsx watch src/index.ts",
    "prebuild": "npm run licensing",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "migrate": "tsx src/migrate.ts",
    "pretest": "npm run licensing",
    "test": "node --import tsx --test src/*.test.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/rate-limit": "^10.3.0",
    "@finedine/licensing": "file:../../packages/licensing",
    "fastify": "^5.12.7",
    "nodemailer": "^7.0.10",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^6.4.17",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
